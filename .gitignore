# Runtime files written next to the program - per machine, never committed
settings.ini
window-positions.ini
snap.log
snap.log.old
taskbar-height.ini

# Stealth Panic Mode, written next to whichever copy is running. The app list is
# a sidecar text file rather than an ini key because ini values cannot contain a
# newline - see the header of src/StealthPanicConfig.ahk.
StealthPanic.ini
StealthPanicApps.txt
StealthPanicApps.txt.tmp

# Per-machine backup of registry values, written by Apply-Windows-Tuning.ps1.
# Committing this would push one PC's original settings onto another.
scripts/tuning-backup.json
animations-backup.json

# Build output
build/out/
*.exe
!Install.bat

# Windows / editor noise
Thumbs.db
desktop.ini
*.lnk
.vscode/
.idea/
build/obj/
**/.claude

# Linux port build output. CMake is run out-of-source as linux/build, but an
# in-source configure scatters CMakeCache.txt / CMakeFiles/ next to the sources,
# so both shapes are covered.
linux/build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
*.o
*.so
*.so.*
*.a
tweaksd

# .NET / C# build output (csharp\). These are also tracked in git from before
# these rules landed - `git rm -r --cached` them or they keep making diff noise.
bin/
obj/
csharp/bin/
csharp/obj/
csharp/publish/
csharp/**/bin/
csharp/**/obj/

# Visual Studio per-user state and caches
.vs/
csharp/.vs/
*.user
*.userosscache
*.userprefs
*.suo
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# NuGet
packages/
*.nupkg
*.snupkg
.nuget/

# Test / coverage output
TestResults/
[Cc]overage*/
*.coverage
*.coveragexml
*.trx

# Publish / signing artefacts
PublishProfiles/*.pubxml.user
*.pfx
*.snk

# Build logs and crash dumps
*.binlog
msbuild.log
*.dmp
