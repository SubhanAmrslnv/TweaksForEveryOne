<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WindowTweaks.app" />

  <!--
    An application manifest is part of what makes this binary identifiable rather than anonymous.
    A window-management utility that installs input hooks and carries NO manifest, no requested
    execution level and no declared OS support is exactly the shape of thing a heuristic scanner
    treats as suspicious. See docs/ANTIVIRUS.md.
  -->

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          asInvoker, and it must stay asInvoker.

          This app needs no administrator rights: it writes only to %APPDATA%\WindowTweaks, reads
          nothing privileged, and installs no service, driver or scheduled task. Asking for
          elevation would be both unnecessary and a far stronger malware signal - and a program
          running elevated can be manipulated into acting on windows it should not touch.

          Only the INSTALLER elevates, because it writes to %ProgramFiles%.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11. Declaring supported OS versions also stops Windows applying legacy
           compatibility shims, which change how window metrics report back to us. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        Per-monitor DPI awareness. This is a correctness requirement, not polish: the app measures
        and moves windows in physical pixels, and a DPI-unaware process is handed VIRTUALISED
        coordinates by Windows. On a mixed-DPI multi-monitor setup that makes every snap, tile and
        monitor-to-monitor move land in the wrong place, with no error to see.
      -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>

      <!-- UTF-8 for the process code page, so paths with non-ASCII characters behave. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
