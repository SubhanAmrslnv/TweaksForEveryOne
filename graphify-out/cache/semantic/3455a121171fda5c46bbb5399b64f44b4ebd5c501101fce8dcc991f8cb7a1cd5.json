{"nodes": [{"id": "linux_claude", "label": "Linux port CLAUDE.md", "file_type": "document", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "linux_claude_tweaksd_daemon", "label": "tweaksd daemon", "file_type": "concept", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C++20/Qt6 daemon reproducing the Windows tray utility's window management on Linux; computes state, backends apply it."}, {"id": "linux_claude_early_scaffold_status", "label": "Early scaffold status (does not manage windows)", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Earlier docs claimed completion; warnings now head every doc and no completion claim may be added without pointing at backing code."}, {"id": "linux_claude_one_way_dependency_flow", "label": "core -> PlatformAdapter -> backend dependency flow", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "core/ is platform-independent and the only place geometry and physics live; a backend applies state, never computes it."}, {"id": "linux_claude_composed_opacity", "label": "Composed opacity (base x named layers)", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absolute alpha writes let one feature clearing transparency destroy another's opacity; ported from Windows RS_AlphaState. One owner per layer name: drag, ghost, breathe, depth, open, gravity."}, {"id": "linux_claude_channel_ownership", "label": "Per-window animation channel ownership (claim/release/owner)", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced drifting hand-written cancel lists on Windows; prevents two animations driving the same property of the same window."}, {"id": "linux_claude_window_eviction", "label": "removeWindow eviction on window death", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it a recycled window id inherits a stranger's opacity."}, {"id": "linux_claude_structural_alpha_off", "label": "Structural alpha off for neutral record", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off is emitted only when base 1.0 and zero layers, not when a product rounds to 1.0; on X11 this deletes _NET_WM_WINDOW_OPACITY rather than setting 0xFFFFFFFF."}, {"id": "linux_claude_swap_and_release_flush", "label": "Swap-and-release flush pattern", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ported from RS_Apply: pending map swapped under lock and applied outside it so a blocking backend cannot stall producers."}, {"id": "linux_claude_dbus_contract", "label": "D-Bus contract org.tweakforeveryone.Daemon", "file_type": "concept", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicated in DBusDaemon.h (authoritative) and extension.js; generating all copies from one definition is the better fix. One-way: signals only, daemon to extension."}, {"id": "linux_claude_wayland_dbus_strategy", "label": "Wayland strategy: compute in daemon, apply via compositor extension", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Wayland client cannot move other windows, set opacity, read the pointer or grab keys."}, {"id": "linux_claude_no_security_bypass", "label": "Refusal to bypass Wayland security", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No LD_PRELOAD, root /dev/input reads, or accessibility API abuse; unsupported features are documented, not hacked in."}, {"id": "linux_claude_frame_period_16ms", "label": "16 ms frame period (vs 15 ms on Windows)", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows 15 ms is a measured compensation for the ~15.6 ms timer tick; do not harmonise without measuring on Linux."}, {"id": "linux_claude_kwin_compiled_plugin", "label": "KDE requires a compiled KWin plugin", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The KWin JS scripting API cannot receive D-Bus signals, so a script could never be driven by the daemon."}, {"id": "linux_claude_cinnamon_extension", "label": "Cinnamon extension requirement", "file_type": "concept", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Panel/actor-level features (taskbar clock, wave) are unreachable from a plain X11 client."}, {"id": "linux_claude_install_sh_lf", "label": "install.sh must stay LF", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CRLF shebang fails only at runtime on Linux."}, {"id": "linux_claude_gnome45_esm", "label": "GNOME 45 ESM extension API break", "file_type": "concept", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "metadata.json claims 42-46 while code uses ESM, 45+ only."}, {"id": "linux_claude_quintic_easing_fix", "label": "Quintic ease-out sign fix", "file_type": "concept", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old expression returned 2.0 at t=0; kept struck-through so nobody reverts the sign."}, {"id": "linux_claude_plasma6_tooling", "label": "Plasma 6 tooling rename (kpackagetool6/qdbus6)", "file_type": "concept", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "install.sh detects both names to serve Plasma 5 and 6."}, {"id": "linux_claude_px_per_second_velocity", "label": "Velocity in px/s with time-constant smoothing", "file_type": "rationale", "source_file": "linux/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared with Windows: throw gain 0.18 px per px/s; smoothing 1-exp(-dt/tau), never per-frame ratios."}], "edges": [{"source": "linux_claude", "target": "linux_claude_tweaksd_daemon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "linux/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "linux_claude", "target": "linux_claude_early_scaffold_status", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "linux/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "linux_claude", "target": "linux_claude_one_way_dependency_flo